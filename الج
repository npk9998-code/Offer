// ── Encode / Decode for URL sharing ──────────────────────
function encodeData(data){
  try{
    const json=JSON.stringify(data);
    const encoded=btoa(unescape(encodeURIComponent(json)));
    return encoded;
  }catch(e){return '';}
}
function decodeData(encoded){
  try{
    const json=decodeURIComponent(escape(atob(encoded)));
    return JSON.parse(json);
  }catch(e){return null;}
}

// ── Check URL on load for shared data ────────────────────
function checkURLImport(){
  try{
    const params=new URLSearchParams(window.location.search);
    const d=params.get('d');
    if(!d) return;
    const data=decodeData(d);
    if(!Array.isArray(data)||!data.length) return;
    // Remove query string from URL cleanly
    window.history.replaceState({},'',window.location.pathname);
    // Show import prompt
    setTimeout(()=>{
      const count=data.length;
      if(confirm('📥 تم استلام '+count+' عرض عبر الرابط.\nهل تريد إضافتها إلى قائمتك؟')){
        let added=0;
        const existingIds=new Set(offers.map(o=>o.id));
        data.forEach(item=>{
          if(typeof item!=='object'||item===null) return;
          const newItem={...EF(),...item,id:item.id&&!existingIds.has(item.id)?item.id:gid()};
          offers.push(newItem);
          existingIds.add(newItem.id);
          added++;
        });
        save();
        toast('✅ تمت إضافة '+added+' عرض من الرابط');
      }
    },600);
  }catch(e){}
}

// ── Show import from link panel ───────────────────────────
function showImportFromLink(){
  closeOverlay('exportOverlay');
  document.getElementById('importLinkInput').value='';
  document.getElementById('importLinkOverlay').style.display='flex';
}

function importFromLink(){
  const raw=document.getElementById('importLinkInput').value.trim();
  if(!raw){toast('الحقل فارغ','err');return;}
  let data=null;
  // Try as URL first
  try{
    const url=new URL(raw);
    const d=url.searchParams.get('d');
    if(d) data=decodeData(d);
  }catch(e){}
  // Try as raw base64
  if(!data) data=decodeData(raw);
  // Try as raw JSON
  if(!data){try{data=JSON.parse(raw);}catch(e){}}

  if(!Array.isArray(data)||!data.length){
    toast('❌ كود أو رابط غير صالح','err');return;
  }
  let added=0;
  const existingIds=new Set(offers.map(o=>o.id));
  data.forEach(item=>{
    if(typeof item!=='object'||item===null) return;
    const newItem={...EF(),...item,id:item.id&&!existingIds.has(item.id)?item.id:gid()};
    offers.push(newItem);
    existingIds.add(newItem.id);
    added++;
  });
  save();
  closeOverlay('importLinkOverlay');
  toast('✅ تمت إضافة '+added+' عرض');
}

// ── Export ────────────────────────────────────────────────
function exportJSON(){
  if(!offers.length){toast('لا توجد بيانات للتصدير','err');return;}
  const encoded=encodeData(offers);
  const shareLink=window.location.href.split('?')[0]+'?d='+encoded;
  // Download file
  const data=JSON.stringify(offers,null,2);
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([data],{type:'application/json;charset=utf-8;'}));
  a.download='عروض_الملاك_'+new Date().toLocaleDateString('ar-SA').replace(/\//g,'-')+'.json';
  a.click();
  closeOverlay('exportOverlay');
  toast('📤 تم تصدير '+offers.length+' عرض');
}

function exportFiltered(){
  const fil=filtered();
  if(!fil.length){toast('لا توجد بيانات للتصدير','err');return;}
  const data=JSON.stringify(fil,null,2);
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([data],{type:'application/json;charset=utf-8;'}));
  a.download='عروض_مفلترة_'+new Date().toLocaleDateString('ar-SA').replace(/\//g,'-')+'.json';
  a.click();
