<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="عروض الملاك">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#052e16">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon.svg">
<title>عروض الملاك العقارية</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --primary:#16a34a;--primary-d:#15803d;--primary-dd:#14532d;
  --bg:#052e16;--surf:#0a3d1f;--surf2:#051a0e;
  --border:rgba(255,255,255,.07);
  --text:#f0fdf4;--muted:#86efac;--dim:#4ade80;
  --st:env(safe-area-inset-top,0px);--sb:env(safe-area-inset-bottom,0px);
}
*,*::before,*::after{box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-touch-callout:none}
html{height:100%;-webkit-text-size-adjust:100%}
body{margin:0;font-family:'Tajawal',sans-serif;background:var(--bg);color:var(--text);min-height:100%}
input,select,textarea{font-size:16px!important;font-family:'Tajawal',sans-serif}
@media(max-width:639px){
  body{position:fixed;width:100%;top:0;left:0;right:0;bottom:0;overflow:hidden}
  #app{height:100%;overflow:hidden}
  .scroll{overflow-y:auto;-webkit-overflow-scrolling:touch}
}
@media(min-width:640px){
  body{padding:calc(var(--st)+16px) 16px calc(var(--sb)+16px);background:#020d06}
  #app{border-radius:22px;overflow:hidden;box-shadow:0 24px 80px rgba(0,0,0,.6)}
  .scroll{overflow-y:auto;max-height:calc(100vh - 260px)}
}
#app{display:flex;flex-direction:column;width:100%;max-width:680px;margin:0 auto;background:var(--bg);position:relative}
.hdr{background:linear-gradient(160deg,#0a3d1f 0%,#052e16 100%);padding:calc(var(--st)+12px) 16px 12px;border-bottom:1px solid rgba(22,163,74,.3);flex-shrink:0}
.hdr-row{display:flex;align-items:center;gap:11px}
.hdr-icon{width:44px;height:44px;background:linear-gradient(135deg,var(--primary),var(--primary-d));border-radius:13px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;box-shadow:0 4px 18px rgba(22,163,74,.4)}
.hdr-title{font-size:16px;font-weight:800;color:var(--text);line-height:1.2}
.hdr-sub{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:5px;margin-top:2px}
.sdot{width:7px;height:7px;border-radius:50%;background:#4ade80;flex-shrink:0}
.stats{display:flex;gap:7px;margin-top:11px;overflow-x:auto;padding-bottom:1px;scrollbar-width:none}
.stats::-webkit-scrollbar{display:none}
.stat{flex:0 0 auto;border-radius:10px;padding:7px 14px;text-align:center;border:1px solid;min-width:64px;cursor:pointer;transition:transform .13s}
.stat:active{transform:scale(.93)}
.stat.on{outline:2px solid var(--primary)}
.stat-n{font-size:21px;font-weight:900;line-height:1}
.stat-l{font-size:10px;color:var(--muted);margin-top:1px}
.scroll{flex:1;overscroll-behavior:contain;padding:12px 13px 6px;scrollbar-width:none}
.scroll::-webkit-scrollbar{display:none}
.tabs{display:flex;background:var(--surf2);border-top:1px solid var(--border);flex-shrink:0;padding-bottom:var(--sb)}
.tab{flex:1;padding:9px 0 7px;border:none;background:transparent;color:#4ade8066;font-size:11px;font-family:'Tajawal',sans-serif;cursor:pointer;font-weight:700;border-top:2.5px solid transparent;transition:all .18s;touch-action:manipulation;-webkit-user-select:none;user-select:none}
.tab.on{color:var(--primary);border-top-color:var(--primary)}
.tab-ic{font-size:19px;display:block;margin-bottom:2px}
.inp{width:100%;padding:12px 13px;border-radius:11px;border:1.5px solid #1a3d2a;background:var(--surf2);color:var(--text);font-size:16px;font-family:'Tajawal',sans-serif;-webkit-appearance:none;outline:none;transition:border-color .18s,box-shadow .18s}
.inp:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(22,163,74,.15)}
textarea.inp{resize:vertical}
.lbl{display:block;color:var(--muted);font-size:12px;margin-bottom:5px;font-weight:600}
.field{margin-bottom:13px}
.dual{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-bottom:13px}
.btn{border:none;border-radius:11px;padding:13px;font-size:15px;font-weight:800;cursor:pointer;font-family:'Tajawal',sans-serif;transition:all .15s;-webkit-user-select:none;user-select:none;touch-action:manipulation;width:100%;display:block}
.btn:active{transform:scale(.96)}
.b-primary{background:linear-gradient(135deg,var(--primary),var(--primary-d));color:#fff;box-shadow:0 4px 16px rgba(22,163,74,.28)}
.b-red{background:linear-gradient(135deg,#dc2626,#991b1b);color:#fff}
.b-ghost{background:rgba(255,255,255,.05);color:var(--muted);border:1px solid var(--border)}
.b-blue{background:linear-gradient(135deg,#2563eb,#1e40af);color:#fff}
.b-purple{background:linear-gradient(135deg,#7c3aed,#5b21b6);color:#fff}
.b-teal{background:linear-gradient(135deg,#0891b2,#0e7490);color:#fff}
.b-orange{background:linear-gradient(135deg,#ea580c,#c2410c);color:#fff}
.chip{display:inline-block;padding:3px 9px;border-radius:7px;font-size:11px;font-weight:800;color:#fff}
.dgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.dbtn{border-radius:11px;padding:12px;font-size:15px;font-weight:800;cursor:pointer;font-family:'Tajawal',sans-serif;transition:all .15s;touch-action:manipulation;border-width:2px;border-style:solid}
.dbtn:active{transform:scale(.95)}
.tgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}
.tbtn{border-radius:11px;padding:11px 6px;font-size:13px;font-weight:800;cursor:pointer;font-family:'Tajawal',sans-serif;transition:all .15s;touch-action:manipulation;border:2px solid #1a3d2a;background:rgba(255,255,255,.03);color:var(--muted)}
.tbtn.on{border-color:var(--primary);background:rgba(22,163,74,.14);color:var(--dim)}
.tbtn:active{transform:scale(.95)}
.filter-row{display:flex;gap:6px;margin-bottom:10px;overflow-x:auto;padding-bottom:2px;scrollbar-width:none}
.filter-row::-webkit-scrollbar{display:none}
.fpill{flex:0 0 auto;padding:5px 13px;border-radius:20px;font-size:12px;font-weight:800;border:1.5px solid #1a3d2a;background:rgba(255,255,255,.03);color:var(--muted);cursor:pointer;font-family:'Tajawal',sans-serif;touch-action:manipulation;transition:all .15s}
.fpill.on{background:rgba(22,163,74,.15);border-color:var(--primary);color:var(--dim)}
.fpill:active{transform:scale(.94)}
.card{border-radius:14px;padding:13px 14px;margin-bottom:9px;border-width:1.5px;border-style:solid;cursor:pointer;transition:transform .13s,filter .13s,outline .15s;-webkit-user-select:none;user-select:none;touch-action:manipulation}
.card:active{transform:scale(.985);filter:brightness(.88)}
.card.duplicate{outline:2.5px solid #f97316!important;outline-offset:1px}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:200;display:flex;align-items:flex-end;justify-content:center;animation:fIn .2s ease}
@keyframes fIn{from{opacity:0}to{opacity:1}}
.sheet{background:var(--surf);border-radius:22px 22px 0 0;width:100%;max-width:680px;padding:22px 18px;padding-bottom:calc(22px + var(--sb));max-height:90vh;overflow-y:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;animation:sUp .22s ease}
.sheet::-webkit-scrollbar{display:none}
@keyframes sUp{from{transform:translateY(50px);opacity:0}to{transform:translateY(0);opacity:1}}
.toast{position:fixed;top:calc(var(--st)+14px);left:50%;transform:translateX(-50%);z-index:999;color:#fff;padding:10px 20px;border-radius:12px;font-weight:800;font-size:13px;font-family:'Tajawal',sans-serif;box-shadow:0 6px 24px rgba(0,0,0,.55);white-space:nowrap;max-width:90vw;animation:tIn .22s ease}
@keyframes tIn{from{opacity:0;transform:translate(-50%,10px)}to{opacity:1;transform:translate(-50%,0)}}
.dup-warn{background:rgba(249,115,22,.12);border:1.5px solid rgba(249,115,22,.4);border-radius:10px;padding:10px 13px;margin-bottom:12px;color:#fb923c;font-size:12px;font-weight:700;display:flex;align-items:center;gap:8px}
.det-row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.06)}
.det-k{color:#4ade8066;font-size:13px}
.det-v{color:var(--text);font-size:13px;font-weight:700;max-width:60%;text-align:left;word-break:break-all}
.act-row{display:flex;gap:9px;margin-top:18px;flex-wrap:wrap}
.act-row .btn{flex:1;min-width:80px}
.srow{display:flex;gap:8px;margin-bottom:10px}
.swrap{flex:1;position:relative}
.sic{position:absolute;right:12px;top:50%;transform:translateY(-50%);color:#4ade8066;font-size:14px;pointer-events:none}
.sinp{padding-right:36px}
.csvbtn{padding:0 13px;font-size:12px;white-space:nowrap;width:auto}
.empty{text-align:center;color:#4ade8066;padding:55px 20px}
.e-ic{font-size:50px;margin-bottom:11px}
.e-t{font-size:15px;font-weight:800;color:var(--muted)}
.e-s{color:#4ade8066;font-size:12px;margin-top:5px}
.install-banner{background:linear-gradient(135deg,rgba(22,163,74,.12),rgba(22,163,74,.05));border:1px solid rgba(22,163,74,.25);border-radius:12px;padding:11px 14px;margin-bottom:13px;display:flex;align-items:center;gap:10px}
.install-banner-text{flex:1;font-size:12px;color:var(--muted);line-height:1.4}
.install-banner-title{font-size:13px;font-weight:800;color:var(--dim);margin-bottom:2px}
.install-x{background:none;border:none;color:#4ade8066;font-size:18px;cursor:pointer;padding:4px;touch-action:manipulation;line-height:1}
.sec-title{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:900;color:var(--text);margin-bottom:16px}
.form-note{text-align:center;color:#4ade8066;font-size:11px;margin-top:14px}
.active-filters{display:flex;gap:6px;align-items:center;margin-bottom:8px;flex-wrap:wrap}
.af-tag{background:rgba(22,163,74,.15);border:1px solid rgba(22,163,74,.35);color:var(--dim);font-size:11px;font-weight:800;padding:3px 10px;border-radius:20px;display:flex;align-items:center;gap:4px}
.af-x{cursor:pointer;font-size:13px;line-height:1}
/* Share styles */
.share-opt{display:flex;align-items:center;gap:14px;padding:14px 16px;border-radius:14px;border:1.5px solid var(--border);background:rgba(255,255,255,.03);cursor:pointer;margin-bottom:10px;transition:all .15s;touch-action:manipulation}
.share-opt:active{transform:scale(.97);background:rgba(255,255,255,.06)}
.share-opt-ic{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}
.share-opt-txt{flex:1}
.share-opt-title{font-size:14px;font-weight:800;color:var(--text)}
.share-opt-sub{font-size:11px;color:var(--muted);margin-top:2px;line-height:1.4}
/* QR code area */
.qr-box{background:white;border-radius:16px;padding:16px;text-align:center;margin:14px 0}
.link-box{background:var(--surf2);border:1.5px solid #1a3d2a;border-radius:11px;padding:11px 14px;font-size:12px;color:var(--muted);word-break:break-all;margin-bottom:12px;line-height:1.5;direction:ltr;text-align:left}
</style>
</head>
<body>
<div id="app">
  <div class="hdr">
    <div class="hdr-row">
      <div class="hdr-icon">🏠</div>
      <div style="flex:1;min-width:0">
        <div class="hdr-title">عروض الملاك العقارية</div>
        <div class="hdr-sub">
          <span class="sdot"></span>
          <span id="stxt">جاري التحميل...</span>
        </div>
      </div>
      <div style="background:rgba(22,163,74,.15);border:1px solid rgba(22,163,74,.35);border-radius:8px;padding:4px 10px;font-size:11px;font-weight:800;color:#4ade80">🏡 ملاك</div>
    </div>
    <div class="stats" id="statsRow"></div>
  </div>
  <div class="scroll" id="scroll"></div>
  <div class="tabs">
    <button class="tab on" id="t0" onclick="goTab(0)"><span class="tab-ic">📋</span>العروض</button>
    <button class="tab" id="t1" onclick="goTab(1)"><span class="tab-ic">➕</span>إضافة</button>
    <button class="tab" id="t2" onclick="goTab(2)"><span class="tab-ic">📊</span>إحصائيات</button>
  </div>
</div>

<div class="toast" id="toast" style="display:none"></div>

<!-- Delete overlay -->
<div class="overlay" id="delOverlay" style="display:none" onclick="closeOverlay('delOverlay')">
  <div class="sheet" onclick="event.stopPropagation()" style="text-align:center">
    <div style="font-size:46px;margin-bottom:8px">🗑️</div>
    <div style="font-size:16px;font-weight:900;margin-bottom:5px">حذف العرض؟</div>
    <div style="color:var(--muted);font-size:12px;margin-bottom:22px">لا يمكن التراجع عن هذا الإجراء</div>
    <div style="display:flex;gap:9px">
      <button class="btn b-red" onclick="confirmDel()">نعم، احذف</button>
      <button class="btn b-ghost" onclick="closeOverlay('delOverlay')">إلغاء</button>
    </div>
  </div>
</div>

<!-- Detail overlay -->
<div class="overlay" id="detOverlay" style="display:none" onclick="closeOverlay('detOverlay')">
  <div class="sheet" id="detSheet" onclick="event.stopPropagation()"></div>
</div>

<!-- Share single offer overlay -->
<div class="overlay" id="shareOneOverlay" style="display:none" onclick="closeOverlay('shareOneOverlay')">
  <div class="sheet" id="shareOneSheet" onclick="event.stopPropagation()"></div>
</div>

<!-- Export / Share All overlay -->
<div class="overlay" id="exportOverlay" style="display:none" onclick="closeOverlay('exportOverlay')">
  <div class="sheet" onclick="event.stopPropagation()">
    <div style="font-size:15px;font-weight:900;margin-bottom:4px">📤 مشاركة ونقل البيانات</div>
    <div style="color:var(--muted);font-size:12px;margin-bottom:18px">اختر طريقة المشاركة المناسبة</div>

    <div class="share-opt" onclick="exportJSON()">
      <div class="share-opt-ic" style="background:rgba(22,163,74,.15)">📥</div>
      <div class="share-opt-txt">
        <div class="share-opt-title">تصدير ملف JSON (كل العروض)</div>
        <div class="share-opt-sub">احفظ ملف وأرسله عبر واتساب أو إيميل — يُستورد في تطبيق المشترين</div>
      </div>
      <span style="color:var(--dim);font-size:18px">›</span>
    </div>

    <div class="share-opt" onclick="exportFiltered()">
      <div class="share-opt-ic" style="background:rgba(37,99,235,.15)">🔍</div>
      <div class="share-opt-txt">
        <div class="share-opt-title">تصدير العروض المفلترة</div>
        <div class="share-opt-sub">صدّر فقط العروض الظاهرة حالياً بعد الفلتر</div>
      </div>
      <span style="color:var(--dim);font-size:18px">›</span>
    </div>

    <div class="share-opt" onclick="shareAllAsText()">
      <div class="share-opt-ic" style="background:rgba(124,58,237,.15)">💬</div>
      <div class="share-opt-txt">
        <div class="share-opt-title">مشاركة كنص (واتساب / تيليجرام)</div>
        <div class="share-opt-sub">أرسل ملخص جميع العروض كرسالة نصية</div>
      </div>
      <span style="color:var(--dim);font-size:18px">›</span>
    </div>

    <div class="share-opt" onclick="showImportFromLink()">
      <div class="share-opt-ic" style="background:rgba(8,145,178,.15)">🔗</div>
      <div class="share-opt-txt">
        <div class="share-opt-title">استيراد من رابط / كود</div>
        <div class="share-opt-sub">الصق رابطاً أو كوداً أرسله لك شخص آخر</div>
      </div>
      <span style="color:var(--dim);font-size:18px">›</span>
    </div>

    <button class="btn b-ghost" style="margin-top:6px" onclick="closeOverlay('exportOverlay')">إلغاء</button>
  </div>
</div>

<!-- Import from link overlay -->
<div class="overlay" id="importLinkOverlay" style="display:none" onclick="closeOverlay('importLinkOverlay')">
  <div class="sheet" onclick="event.stopPropagation()">
    <div style="font-size:15px;font-weight:900;margin-bottom:6px">🔗 استيراد من رابط / كود</div>
    <div style="color:var(--muted);font-size:12px;margin-bottom:14px;line-height:1.6">
      الصق الرابط أو الكود المُشارَك معك من جهاز آخر
    </div>
    <textarea id="importLinkInput" class="inp" rows="5" placeholder="الصق الرابط أو كود البيانات هنا..." style="margin-bottom:12px;direction:ltr;font-size:13px"></textarea>
    <button class="btn b-primary" onclick="importFromLink()" style="margin-bottom:9px">📥 استيراد</button>
    <button class="btn b-ghost" onclick="closeOverlay('importLinkOverlay')">إلغاء</button>
  </div>
</div>

<script>
const DC={
  'شمال':{bg:'#fef2f2',border:'#fca5a5',badge:'#ef4444',text:'#991b1b'},
  'جنوب':{bg:'#fefce8',border:'#fde047',badge:'#ca8a04',text:'#713f12'},
  'شرق': {bg:'#eff6ff',border:'#93c5fd',badge:'#2563eb',text:'#1e3a8a'},
  'غرب': {bg:'#f0fdf4',border:'#86efac',badge:'#16a34a',text:'#14532d'},
};
const DIRS=['شمال','جنوب','شرق','غرب'];
const TYPES=['أرض','فيلا','عمارة','شقة','محل'];
const KEY='owners_offers_v1';
const INSTALL_KEY='owners_install_dismissed';

let offers=[],tab=0,editId=null,delId=null,showBanner=false;
let search='',filterDirs=[],filterTypes=[];
let toastT=null;
const EF=()=>({direction:'',sellerName:'',sellerPhone:'',neighborhood:'',propertyType:'',area:'',streetWidth:'',price:'',notes:''});
let form=EF();

// ── Init ──────────────────────────────────────────────────
function init(){
  try{offers=JSON.parse(localStorage.getItem(KEY)||'[]');}catch(e){offers=[];}
  showBanner=!localStorage.getItem(INSTALL_KEY)&&!window.matchMedia('(display-mode: standalone)').matches;
  // Check URL for shared data
  checkURLImport();
  render();
  if('serviceWorker' in navigator) navigator.serviceWorker.register('./sw.js').catch(()=>{});
  window.addEventListener('beforeinstallprompt',e=>{window._installPrompt=e;e.preventDefault();});
}
function save(){try{localStorage.setItem(KEY,JSON.stringify(offers));}catch(e){}render();}

// ── Toast ─────────────────────────────────────────────────
function toast(msg,type='ok'){
  clearTimeout(toastT);
  const el=document.getElementById('toast');
  el.textContent=msg;el.style.display='block';
  el.style.background=type==='err'?'#dc2626':type==='warn'?'#f97316':type==='info'?'#0284c7':'#15803d';
  toastT=setTimeout(()=>el.style.display='none',3500);
}

// ── Duplicate detection ───────────────────────────────────
function findDuplicates(){
  const phoneMap={},dup=new Set();
  offers.forEach(o=>{
    if(o.sellerPhone){
      if(phoneMap[o.sellerPhone]!==undefined) dup.add(o.id);
      else phoneMap[o.sellerPhone]=true;
    }
  });
  return dup;
}

function syncFormFromDOM(){
  ['sellerName','sellerPhone','neighborhood','area','streetWidth','price','notes'].forEach(k=>{
    const el=document.getElementById('f_'+k);
    if(el) form[k]=el.value;
  });
}

function goTab(n){
  if(tab===1) syncFormFromDOM();
  tab=n;
  if(n!==1&&editId){editId=null;form=EF();}
  [0,1,2].forEach(i=>document.getElementById('t'+i).className='tab'+(i===n?' on':''));
  render();
}
function closeOverlay(id){document.getElementById(id).style.display='none';}

function toggleDirFilter(d){
  const i=filterDirs.indexOf(d);
  if(i>=0) filterDirs.splice(i,1); else filterDirs.push(d);
  if(tab!==0) goTab(0); else render();
}
function toggleTypeFilter(t){
  const i=filterTypes.indexOf(t);
  if(i>=0) filterTypes.splice(i,1); else filterTypes.push(t);
  render();
}
function clearFilters(){filterDirs=[];filterTypes=[];render();}

function filtered(){
  let res=offers;
  if(search.trim()){
    const q=search.trim();
    res=res.filter(o=>[o.sellerName,o.sellerPhone,o.direction,o.propertyType,o.neighborhood].some(v=>v&&v.includes(q)));
  }
  if(filterDirs.length) res=res.filter(o=>filterDirs.includes(o.direction));
  if(filterTypes.length) res=res.filter(o=>filterTypes.includes(o.propertyType));
  return res;
}

// ── Render ────────────────────────────────────────────────
function render(){
  renderStats();
  document.getElementById('stxt').textContent=offers.length+' عرض • محفوظ على جهازك';
  const sc=document.getElementById('scroll');
  if(tab===0)      sc.innerHTML=renderList();
  else if(tab===1) sc.innerHTML=renderForm();
  else             sc.innerHTML=renderStats2();
}

function renderStats(){
