// ── Share helpers ─────────────────────────────────────────
function doShareText(text){
  if(navigator.share) navigator.share({title:'عرض عقاري',text:text}).catch(()=>{});
  else copyToClipboard(text,'تم نسخ النص');
}

function shareAsLink(link, title){
  if(navigator.share) navigator.share({title:title||'عرض عقاري',url:link}).catch(()=>{
    copyToClipboard(link,'تم نسخ الرابط');
  });
  else copyToClipboard(link,'تم نسخ الرابط');
}

function copyToClipboard(text, msg){
  if(navigator.clipboard){
    navigator.clipboard.writeText(text).then(()=>toast('✅ '+msg)).catch(()=>fallbackCopy(text,msg));
  } else fallbackCopy(text,msg);
}
function fallbackCopy(text,msg){
  const ta=document.createElement('textarea');
  ta.value=text;ta.style.position='fixed';ta.style.opacity='0';
  document.body.appendChild(ta);ta.focus();ta.select();
  try{document.execCommand('copy');toast('✅ '+msg);}catch(e){toast('❌ تعذّر النسخ','err');}
  document.body.removeChild(ta);
}

