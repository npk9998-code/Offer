<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="عقارات">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0f172a">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon.svg">
<title>مدير العروض العقارية</title>
<style>
  /* استخدام خطوط النظام لضمان العمل بدون إنترنت بنسبة 100% */
  :root {
    --gold: #f59e0b; --bg: #0f172a; --surf: #1e293b; --text: #f8fafc;
    font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
  }
  body { background: var(--bg); color: var(--text); margin: 0; padding: env(safe-area-inset-top) 20px 20px; }
  /* تم تحسين التنسيق ليعمل كـ تطبيق حقيقي */
</style>
</head>
<body>
<div id="app"></div>
<script>
  // تفعيل ميزة العمل بدون إنترنت (Offline Mode)
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('./sw.js').catch(err => console.log('SW error:', err));
    });
  }
</script>
</body>
</html>
